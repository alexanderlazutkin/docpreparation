# .env.example — шаблон конфигурации docpreparation. Скопировать в .env
# (не коммитится) и раскомментировать нужное.
#
# КОГДА ПРИМЕНЯЮТСЯ ПАРАМЕТРЫ — .env читают ОБА входных скрипта, каждый берёт
# только свои переменные:
#   1) ./services.sh start|restart — блок «СЕРВИСЫ» (пути моделей, порты,
#      parallel/ctx, WAIT_SVC): читаются ОДНОКРАТНО при запуске llama-server.
#      Правка значения НЕ действует на уже поднятый сервис — нужен restart;
#      для смены OCR_PROXY_BLOCK_ENGINE / --surya-* — явный stop -> start
#      (restart --no-llm surya не перезапускает; см. HANDOFF «Грабли»).
#   2) scripts/launch_batch.sh -> prepare_all.sh -> prepare_doc.sh — блок
#      «ПАЙПЛАЙН» (CAPTION_*, RETRY_OCR, SURYA_INFERENCE_URL): launch_batch
#      сам .env не читает, его подхватывает prepare_doc.sh (стадии [1-6]) при
#      КАЖДОМ запуске батча/документа — restart сервисов НЕ нужен.
#   3) SURYA_PORT / OCR_PROXY_PORT читают ОБЕ стороны (сервисы биндят,
#      пайплайн по ним аттачится) — менять только согласованно.
# Закомментировано = встроенное значение по умолчанию (деф.).

# ============================================================ СЕРВИСЫ ======
# Применяются ТОЛЬКО при ./services.sh start|restart (загрузка моделей в GPU).

# --- Surya VLM (:8510) — OCR/layout для marker ----------------------------
# GGUF-весы, проверены байт-в-байт с HF Hub. Используются и marker'ом, если
# он сам спавнит сервер (когда :8510 недоступен — обычно не нужно).
SURYA_GGUF_LOCAL_MODEL_PATH=/media/llm/Models/OCR/surya-ocr-2-gguf/surya-2.gguf
SURYA_GGUF_LOCAL_MMPROJ_PATH=/media/llm/Models/OCR/surya-ocr-2-gguf/surya-2-mmproj.gguf
#SURYA_PORT=8510            # деф. 8510; см. п.3 выше (общий с пайплайном)
#SURYA_PARALLEL=8           # деф. 8 слотов llama-server (замеры: p=8 оптимально)
#SURYA_CTX=98304            # деф. = SURYA_PARALLEL x 12288 — не задавать без нужды

# --- LLM/VLM (:8080) — captioning фигур + --use_llm marker ----------------
# Qwen3.6-35B-A3B (32,7 ГБ): ~5 с/фигура при CAPTION_PARALLEL=2.
#LLM_MODEL=/media/llm/Models/unsloth/Qwen3.6-35B-A3B-MTP-GGUF/Qwen3.6-35B-A3B-UD-Q6_K_XL.gguf
#LLM_MMPROJ=/media/llm/Models/unsloth/Qwen3.6-35B-A3B-MTP-GGUF/mmproj-F32.gguf
                              # деф. mmproj-F32.gguf; пусто = текст-only сервис
#LLM_PORT=8080              # деф. 8080
#LLM_PARALLEL=2             # деф. 2 слота (35B: 2 x 16k)
#LLM_CTX=32768              # деф. 32768

# --- PaddleOCR-VL (:8512) + OCR-прокси (:8511) — только с --ocr-proxy -----
# Поднимаются services.sh start --ocr-proxy (рекомендуется всегда).
#PADDLE_MODEL=/media/llm/Models/OCR/PaddleOCR-VL-1.6/PaddleOCR-VL-1.6-GGUF.gguf
#PADDLE_MMPROJ=/media/llm/Models/OCR/PaddleOCR-VL-1.6/PaddleOCR-VL-1.6-GGUF-mmproj.gguf
#PADDLE_PORT=8512           # деф. 8512
#PADDLE_PARALLEL=8          # деф. 8
#PADDLE_CTX=65536           # деф. = PADDLE_PARALLEL x 8192
#OCR_PROXY_PORT=8511        # деф. 8511; общий с пайплайном (см. п.3)
#OCR_PROXY_BLOCK_ENGINE=surya
                              # деф. surya (pass-through, безопасно); paddle —
                              # эксперимент: block-OCR быстрее в 3-5x, но
                              # table-fallback теряет таблицы (USAGE §3.6-4).
                              # Смена требует stop -> start --ocr-proxy.

# --- Прочее (сервисы) -------------------------------------------------------
#SURYA_INFERENCE_HOST=127.0.0.1   # деф. 127.0.0.1 — хост, на котором биндит
                              # llama-server (services.sh)
#WAIT_SVC=600               # деф. 600 с — ожидание загрузки модели в GPU

# ============================================================ ПАЙПЛАЙН =====
# Применяются при КАЖДОМ запуске launch_batch.sh / prepare_doc.sh — сервисы
# должны быть уже подняты; их restart не нужен.

# --- Captioning (caption_figures.py, стадия [2/6]) ------------------------
#CAPTION_FIGURES=1          # деф. 1; 0 = отключить captioning в prepare_doc
#CAPTION_PARALLEL=1         # деф. 1; локально оптимально 2 (оба слота :8080,
                              # так в рабочем .env), для облака — 6+
#CAPTION_API=http://127.0.0.1:8080/v1
                              # деф. = локальный LLM-сервис (:8080); облако
                              # (ускорение): https://open.cherryin.net/v1 —
                              # ключ подтянется из CHERRY_API_KEY
#CAPTION_MODEL=             # деф. "" = первый id из /v1/models; для облака,
                              # напр.: qwen/qwen3-vl-30b-a3b-instruct(free);
                              # резерв: qwen/qwen3-vl-plus, deepseek/deepseek-ocr(free)
#CAPTION_API_KEY=sk-...     # деф. нет; для Cherry-шлюза не нужно — берётся
                              # из CHERRY_API_KEY
#CAPTION_FORCE_KWARGS=1     # деф. выкл; включать только если провайдер
                              # понимает chat_template_kwargs (локально — авто)
#CAPTION_MIN_BYTES=20000    # деф. 20000: файлы-картинки меньше — скип
                              # (иконки/мелочь, норма)
#CAPTION_STRUCTURED=0       # деф. 0 (ВЫКЛ); в рабочем .env ВКЛЮЧЕНО (=1,
                              # решение 2026-10-19: финальные прогоны всегда
                              # structured). Схемы -> prose + Mermaid +
                              # «Связи:»; таблицы -> pipe-MD с пометкой
                              # «сверить с PDF»; ~x2-3 токенов/времени на
                              # фигуру; требует node/npx — валидация mmdc
#CAPTION_LANG=ru            # деф. ru; закомментировано = авто-детект языка
                              # документа (--lang > CAPTION_LANG > авто: имя
                              # файла -> текст -> метаданные PDF)
#CAPTION_PROMPT=            # деф. ВСТРОЕННЫЕ промпты ПО ЯЗЫКУ документа (ru/en)
                              # — инструкции на языке ответа; рус. шаблон с
                              # «на английском» давал ~14% русских описаний на
                              # англ. документах (Ponniah, 2026-10-16).
                              # Своё переопределяет ОБА языка; плейсхолдеры:
                              # {ctx} — контекст, {lang} — «русском»/
                              # «английском», \n — перевод строки; при алфавитном
                              # несоответствии — предупреждение в лог.

# --- marker / аттач к сервисам ---------------------------------------------
#SURYA_INFERENCE_URL=       # деф. авто: OCR-прокси :8511 (если поднят), иначе
                              # surya :8510; явное значение минует авто-аттач
#SURYA_INFERENCE_BACKEND=llamacpp
                              # деф. auto (на не-NVIDIA = llamacpp/Vulkan);
                              # нужен только если marker сам спавнит сервер
                              # (обычно аттачится к готовому)
#RETRY_OCR=0                # деф. 0; 1 = эквивалент флага --retry-ocr
                              # (ретрай всего документа с --force_ocr)

# --use_llm задаётся флагами marker_single (см. README, раздел 4), не через env
