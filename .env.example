# Скопировать в .env (не коммитится). Подхватывается scripts/prepare_doc.sh.

# Surya VLM: локальные GGUF-веса, проверены байт-в-байт с HF Hub (актуальны)
SURYA_GGUF_LOCAL_MODEL_PATH=/media/llm/Models/OCR/surya-ocr-2-gguf/surya-2.gguf
SURYA_GGUF_LOCAL_MMPROJ_PATH=/media/llm/Models/OCR/surya-ocr-2-gguf/surya-2-mmproj.gguf

# Инференс-бэкенд: на не-NVIDIA по умолчанию llamacpp (llama-server из PATH, Vulkan/GPU)
# SURYA_INFERENCE_BACKEND=llamacpp

# Постоянные сервисы (services.sh): prepare_doc.sh сам аттачится к поднятому surya
SURYA_PORT=8510
#SURYA_INFERENCE_URL=http://127.0.0.1:8510/v1
LLM_PORT=8080

# OCR-прокси (services.sh start --ocr-proxy): PaddleOCR-VL для block-OCR
# (быстрый путь, USAGE §3.6); prepare_doc.sh аттачится к :8511 автоматически
#PADDLE_MODEL=/media/llm/Models/OCR/PaddleOCR-VL-1.6/PaddleOCR-VL-1.6-GGUF.gguf
#PADDLE_MMPROJ=/media/llm/Models/OCR/PaddleOCR-VL-1.6/PaddleOCR-VL-1.6-GGUF-mmproj.gguf
#PADDLE_PORT=8512
#PADDLE_PARALLEL=8
#OCR_PROXY_PORT=8511
#OCR_PROXY_BLOCK_ENGINE=surya   # деф. surya (pass-through); paddle — эксперимент:
#                                # block-OCR быстрее в 3-5x, но table-fallback падает (§3.6-4)
# LLM/VLM: captioning фигур + --use_llm (32.7 ГБ; ~13 с/фигура)
LLM_MODEL=/media/llm/Models/unsloth/Qwen3.6-35B-A3B-MTP-GGUF/Qwen3.6-35B-A3B-UD-Q6_K_XL.gguf
LLM_MMPROJ=/media/llm/Models/unsloth/Qwen3.6-35B-A3B-MTP-GGUF/mmproj-F32.gguf
#CAPTION_FIGURES=0   # отключить captioning в prepare_doc.sh

# Промпт VLM-описаний: по умолчанию — ВСТРОЕННЫЕ промпты ПО ЯЗЫКУ документа
# (ru/en; инструкции на языке ответа — единый рус. шаблон с «на английском»
# давал ~14% русских описаний на англ. документах). Своё переопределение —
# ниже (действует на ОБА языка; плейсхолдеры: {ctx} — контекст, {lang} —
# «русском»/«английском», \n — перевод строки; при алфавитном несоответствии
# целевому языку — предупреждение в лог).
#CAPTION_PROMPT="…{ctx}…{lang}…"
# Язык VLM-описаний (ru|en): закомментировано = авто-детект языка документа
# (имя файла -> текст -> метаданные PDF; лог в prepare_doc), деф. ru.
#CAPTION_LANG=ru

# Структурированные VLM-описания (PLAN-VLM, этап 1; пилот: 8/8 Mermaid):
# схемы -> prose + Mermaid (тип по содержимому: er/flowchart/sequence/state/
# class/mindmap) + текстовый список связей (главный RAG-выигрыш); таблицы ->
# pipe-MD реконструкция с пометкой «сверить с PDF». Mermaid валидируется mmdc
# (npx -y @mermaid-js/mermaid-cli; нужен node; puppeteer --no-sandbox сам),
# ретрай x1 с текстом ошибки, фолбэк prose. Токены/время ~x2-3 на фигуру —
# для финальных прогонов, не для черновиков.
#CAPTION_STRUCTURED=0

# Облачный провайдер для captioning (OpenAI-совместимый API) — ускорение
# обработки (локальная 35B: ~5 с/фигура последовательно; облако + --parallel).
# Cherry-шлюз (как в конфиге opencode): ключ подтянется из CHERRY_API_KEY.
#CAPTION_API=https://open.cherryin.net/v1
#CAPTION_MODEL=qwen/qwen3-vl-30b-a3b-instruct(free)
#CAPTION_PARALLEL=6   # для облака; локально оптимально 2 (деф. в .env)
# резерв: qwen/qwen3-vl-plus ; OCR-специализированная: deepseek/deepseek-ocr(free)
# Для иного провайдера задать явно:
#CAPTION_API_KEY=sk-...
#CAPTION_FORCE_KWARGS=1   # только если провайдер понимает chat_template_kwargs

# --use_llm задаётся флагами marker_single (см. README, раздел 4), не через env
